{
    "name": "tryp_ben_hpc",
    "structure_version": "1.5",
    "workflow": {
        "type": "workflow",
        "structure_version": "1.1",
        "components": {
            "members": [
                {
                    "name": "receptor",
                    "selector": {
                        "type": "mdtraj",
                        "selection_string": "protein"
                    },
                    "type": "protein"
                },
                {
                    "name": "ligand",
                    "selector": {
                        "type": "resname",
                        "resname": "BEN",
                        "include_hydrogens": true
                    },
                    "type": "small_molecule",
                    "sdf_file": "",
                    "resname": "BEN"
                }
            ],
            "group_selectors": [
                {
                    "type": "binding_site",
                    "name": "binding_site",
                    "reference_component_name": "ligand",
                    "random_seed": 111
                }
            ]
        },
        "cv_specs": [
            {
                "name": "distance_site_ligand",
                "type": "com_com_distance",
                "group1_selection_name": "binding_site",
                "group2_selection_name": "ligand",
                "min_value": 0.0,
                "max_value": 3.0
            }
        ],
        "anchor_spec": {
            "type": "graded",
            "inner_spacing": 0.075,
            "outer_spacing": 0.15,
            "surface_margin": 0.3
        },
        "procedure": {
            "name": "procedure",
            "position_reporter_interval": null,
            "type": "composite",
            "procedures": [
                {
                    "name": "equilibration",
                    "position_reporter_interval": null,
                    "type": "equilibration_globular",
                    "reference_structure_filename": "protein_ligand.pdb",
                    "align_selection_str": "protein and not type H"
                },
                {
                    "name": "metadynamics",
                    "position_reporter_interval": null,
                    "type": "seeding",
                    "method_input": {
                        "type": "metadynamics",
                        "bias_factor": 10.0,
                        "gaussian_height": 1.0,
                        "gaussian_width": 0.05,
                        "steps_per_update": 250,
                        "number_of_points": 101
                    },
                    "cv_names": [
                        "distance_site_ligand"
                    ],
                    "ensemble": "NVT",
                    "reporter_interval": 100
                },
                {
                    "name": "MMVT",
                    "position_reporter_interval": null,
                    "type": "mmvt",
                    "ensemble": "NVT",
                    "number_of_steps": 1000000,
                    "checkpoint_interval": 10000
                },
                {
                    "name": "bd",
                    "position_reporter_interval": null,
                    "type": "bd",
                    "n_trajectories_per_output": 1000,
                    "n_steps_per_output": 100000,
                    "number_of_trajectories": 100000
                }
            ]
        },
        "scale_settings": [
            {
                "type": "molecular_dynamics",
                "system": {
                    "parameters_topology": {
                        "type": "OpenMM_system",
                        "system_filename": "work/parameterize/complex_system.xml",
                    },
                    "solvated_pdb": "work/parameterize/complex_solvent.pdb"
                },
                "nonbonded_method": "pme",
                "nonbonded_cutoff": 0.9,
                "constraints": "hbonds",
                "hydrogen_mass": 3.0,
                "timestep": 0.004,
                "friction_coefficient": 1.0,
                "integrator_type": "langevinMiddle",
                "platform_type": "cuda"
            },
            {
                "type": "brownian_dynamics",
                "engine": "browndye",
                "geometry": "sphere",
                "system": {
                    "molecules": [
                        {
                            "name": "receptor",
                            "component_name": "receptor",
                            "pqr_filename": "",
                            "role": "receptor"
                        },
                        {
                            "name": "ligand",
                            "component_name": "ligand",
                            "pqr_filename": "",
                            "role": "ligand"
                        }
                    ]
                },
                "binary_directory": "",
                "auxiliary_directory": ""
            }
        ],
        "plugins": []
    },
    "physical_attributes": {
        "temperature": 300.0,
        "pressure": null,
        "ionic_strength": 0.15,
        "random_seed": 111
    },
    "work_directory": "work_hpc",
    "root_directory": null,
    "parameterizer": null,
    "run_settings": {
        "resources": [
            {
                "type": "slurm_remote",
                "name": "delta",
                "remote_working_directory": "/scratch/YOUR_DIRECTORY/$USER/seekrflow_playground/",
                "max_workers_per_node": 1,
                "partition": "gpuA100x4,gpuA40x4",
                "account": "YOUR ACCOUNT NAME",
                "constraint": "scratch",
                "nodes_per_block": 1,
                "cpus_per_task": 32,
                "memory_per_node": 5000,
                "time_limit": "48:00:00",
                "scheduler_options": "--gpus-per-node=1 --gpu-bind=closest",
                "worker_init": "source $HOME/.bashrc; conda activate SEEKR; nvidia-cuda-mps-control -d",
                "remote_interface": {
                    "type": "globus_compute_sdk",
                    "endpoint_id": "YOUR GLOBUS COMPUTE ENDPOINT"
                },
                "transfer_settings": {
                    "type": "globus",
                    "local_collection_id": "YOUR LOCAL COLLECTION ID",
                    "remote_collection_id": "7e936164-de58-4e3d-85da-21aa23c07169"
                }
            },
            {
                "type": "slurm_remote",
                "name": "anvil",
                "remote_seekr2_directory": "$HOME/seekr2/seekr2/",
                "remote_seekrtools_directory": "$HOME/seekrtools/seekrtools/",
                "remote_working_directory": "/anvil/scratch/$USER/seekrflow_playground",
                "max_workers_per_node": 1,
                "partition": "gpu",
                "account": "YOUR ACCOUNT NAME",
                "nodes_per_block": 1,
                "cpus_per_task": 4,
                "memory_per_node": 5000,
                "time_limit": "00:30:00",
                "scheduler_options": "--gres gpu:1 --gpus-per-node=1",
                "worker_init": "module load modtree/gpu; conda activate SEEKR2",
                "remote_interface": {
                    "type": "globus_compute_sdk",
                    "endpoint_id": "YOUR GLOBUS COMPUTE ENDPOINT"
                },"transfer_settings": {
                    "type": "globus",
                    "local_collection_id": "YOUR LOCAL COLLECTION ID",
                    "remote_collection_id": "c42f0096-2d87-42f9-8e6a-edd08f2e1834"
                }
            },
            {
                "type": "slurm_remote",
                "name": "delta_ssh_and_rsync",
                "remote_seekr2_directory": "/path/to/your/seekr2/seekr2/",
                "remote_seekrtools_directory": "/path/to/your/seekrtools/seekrtools/",
                "remote_working_directory": "/path/to/scratch/seekrflow_playground/",
                "max_workers_per_node": 1,
                "partition": "gpuA100x4,gpuA40x4",
                "account": "YOUR ACCOUNT NAME",
                "constraint": "scratch",
                "nodes_per_block": 1,
                "cpus_per_task": 32,
                "memory_per_node": 64000,
                "time_limit": "00:30:00",
                "scheduler_options": "--gpus-per-node=1 --gpu-bind=closest",
                "worker_init": "source /path/to/your/.bashrc; conda activate SEEKR2; export OPENMM_CUDA_COMPILER=/path/to/your/nvcc",
                "remote_interface": {
                    "type": "ssh",
                    "hostname": "login.delta.ncsa.illinois.edu"
                },
                "transfer_settings": {
                    "type": "rsync",
                    "hostname": "login.delta.ncsa.illinois.edu"
                }
            }
        ],
        "placements": [
            { "target": [], "resource": "local" },
            { "target": ["equilibration"], "resource": "local" },
            { "target": ["metadynamics", "sampling"], "resource": "anvil" },
            { "target": ["metadynamics", "logistic"], 
              "resource": "anvil",
              "co_schedule_with": "predecessor"
            },
            { "target": ["MMVT"], 
              "resource": "delta",
              "dispatch": {
                    "type": "dispatch",
                    "dimensions": [
                        "anchors"
                    ],
                    "group_size": 1,
                    "concurrency": 1
                },
              "mps": 2,
              "time_policy": {
                    "type": "adaptive",
                    "estimated_performance": 500.0,
                    "safety_factor": 0.2,
                    "min_time_limit": null,
                    "max_time_limit": null
                }
            },
            { "target": ["bd"], "resource": "local" }
        ]
    }
}
