{
  "jobDefinitionName": "",
  "type": "container",
  "containerProperties": {
    "image": "628031635908.dkr.ecr.us-west-2.amazonaws.com/seekr-engines-bd:latest",
    "resourceRequirements": [
      {
        "type": "GPU",
        "value": "1"
      },
      {
        "type": "VCPU",
        "value": "4"
      },
      {
        "type": "MEMORY",
        "value": "24000"
      }
    ],
    "environment": [
      {
        "name": "SEEKRFLOW_STAGE",
        "value": "hidr"
      },
      {
        "name": "SEEKRFLOW_S3_PREFIX",
        "value": "s3://REPLACE_ME_BUCKET/REPLACE_ME_PREFIX"
      },
      {
        "name": "SEEKRFLOW_ANCHOR_INDEX",
        "value": "0"
      }
    ],
    "command": [
      "bash",
      "-lc",
      "python -m seekrflow.run_stage --stage $SEEKRFLOW_STAGE --s3-prefix $SEEKRFLOW_S3_PREFIX --anchor-index $SEEKRFLOW_ANCHOR_INDEX"
    ],
    "logConfiguration": {
      "logDriver": "awslogs"
    }
  },
  "platformCapabilities": [
    "EC2"
  ]
}
