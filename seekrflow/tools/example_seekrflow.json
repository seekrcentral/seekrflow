{
    "name": "example_seekrflow",
    "structure_version": "1.5",
    "workflow": {
        "type": "workflow",
        "structure_version": "1.1",
        "components": {
            "members": [
                {
                    "name": "receptor",
                    "selector": {
                        "type": "mdtraj",
                        "selection_string": "protein"
                    },
                    "type": "protein"
                },
                {
                    "name": "ligand",
                    "selector": {
                        "type": "resname",
                        "resname": "LIG",
                        "include_hydrogens": true
                    },
                    "type": "small_molecule",
                    "sdf_file": "",
                    "resname": "LIG"
                }
            ],
            "group_selectors": []
        },
        "cv_specs": [
            {
                "name": "distance_receptor_ligand",
                "type": "com_com_distance",
                "group1_selection_name": "receptor",
                "group2_selection_name": "ligand",
                "min_value": 0.5,
                "max_value": 1.6
            }
        ],
        "anchor_spec": {
            "type": "uniform",
            "n_anchors": 12
        },
        "procedure": {
            "name": "procedure",
            "position_reporter_interval": null,
            "type": "composite",
            "procedures": []
        },
        "scale_settings": [
            {
                "type": "molecular_dynamics",
                "system": null,
                "nonbonded_method": "pme",
                "nonbonded_cutoff": 0.9,
                "constraints": "hbonds",
                "hydrogen_mass": 3.0,
                "timestep": 0.002,
                "friction_coefficient": 1.0,
                "integrator_type": "langevin",
                "platform_type": "cuda"
            },
            {
                "type": "brownian_dynamics",
                "engine": "browndye",
                "geometry": "sphere",
                "system": {
                    "molecules": [
                        {
                            "name": "receptor",
                            "component_name": "receptor",
                            "pqr_filename": "",
                            "role": "receptor"
                        },
                        {
                            "name": "ligand",
                            "component_name": "ligand",
                            "pqr_filename": "",
                            "role": "ligand"
                        }
                    ]
                },
                "binary_directory": "",
                "auxiliary_directory": ""
            }
        ],
        "plugins": []
    },
    "physical_attributes": {
        "temperature": 298.15,
        "pressure": null,
        "ionic_strength": 0.15,
        "random_seed": 0
    },
    "work_directory": "work",
    "root_directory": null,
    "parameterizer": {
        "complex_pdb_filename": "protein_ligand.pdb",
        "forcefields": [
            "amber/ff14SB.xml",
            "amber/tip3p_standard.xml",
            "amber/tip3p_HFE_multivalent.xml"
        ],
        "small_molecule_forcefield": "gaff-2.11",
        "water_model": "tip3p",
        "pdb_fixer_settings": {
            "remove_extra_chains": true,
            "keep_chain_indices": null,
            "find_missing_residues": true,
            "find_and_replace_nonstandard_residues": true,
            "remove_heterogens": false,
            "find_and_add_missing_atoms": true,
            "add_missing_hydrogens_pH": null
        },
        "pdb2pqr_settings": {
            "forcefield": "PARSE",
            "forcefield_output_format": "AMBER",
            "pH": 7.0
        },
        "pdb_to_sdf_settings": {
            "engine": "rdkit"
        },
        "solvent_padding": 0.9,
        "box_shape": "octahedron"
    },
    "run_settings": {
        "resources": [
            {
                "type": "slurm_remote",
                "name": "delta",
                "remote_working_directory": "/scratch/kif/USERNAME/seekrflow_playground/",
                "partition": "gpuA100x4,gpuA40x4",
                "account": "kif-delta-gpu",
                "constraint": "scratch",
                "nodes_per_block": 1,
                "cpus_per_task": 32,
                "memory_per_node": 48000,
                "time_limit": "00:30:00",
                "scheduler_options": "#SBATCH --gpus-per-node=1 --gpu-bind=closest",
                "worker_init": "source $HOME/.bashrc; conda activate SEEKR2; export OPENMM_CUDA_COMPILER=`which nvcc`",
                "mps": 1,
                "remote_interface": {
                    "type": "globus_compute_sdk",
                    "endpoint_id": "MY_ENDPOINT_ID"
                },
                "transfer_settings": {
                    "type": "globus",
                    "local_collection_id": "MY_LOCAL_COLLECTION_ID",
                    "remote_collection_id": "MY_REMOTE_COLLECTION_ID"
                }
            }
        ],
        "placements": [
            {
                "target": [],
                "resource": "local",
                "dispatch": null,
                "co_schedule_with": null,
                "cpus": null,
                "memory_mb": null,
                "time_limit": null,
                "mps": null,
                "time_policy": null
            },
            {
                "target": [
                    "equilibration"
                ],
                "resource": "local",
                "dispatch": null,
                "co_schedule_with": null,
                "cpus": null,
                "memory_mb": null,
                "time_limit": null,
                "mps": null,
                "time_policy": null
            },
            {
                "target": [
                    "metadynamics",
                    "sampling"
                ],
                "resource": "delta",
                "dispatch": null,
                "co_schedule_with": null,
                "cpus": null,
                "memory_mb": null,
                "time_limit": null,
                "mps": null,
                "time_policy": null
            },
            {
                "target": [
                    "metadynamics",
                    "logistic"
                ],
                "resource": "local",
                "dispatch": null,
                "co_schedule_with": null,
                "cpus": null,
